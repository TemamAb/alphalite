# AlphaPro Dashboard - Production Environment Variables
# API URL for production - will be set by render.yaml during build
# Leave empty to use relative URLs (requires nginx proxy)
VITE_API_URL=

# Production settings
NODE_ENV=production
VITE_APP_TITLE=AlphaPro Dashboard
VITE_APP_VERSION=1.0.0

# Alternative: Uncomment and set your Render API URL directly
# VITE_API_URL=https://your-api-service.onrender.com
