# AlphaPro Environment Variables
# Copy this file to .env and fill in your actual values.

# --- Core Engine & Wallet Configuration ---
# Your EOA private key for signing transactions. CRITICAL.
PRIVATE_KEY=0x...
# The EOA wallet address corresponding to the private key.
WALLET_ADDRESS=0x...
# Set to LIVE for real opportunity detection.
TRADING_MODE=LIVE

# --- Blockchain RPC & WebSocket Endpoints ---
# REQUIRED for LIVE mode. Use a reliable provider like Alchemy, Infura, etc.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional: Add other L1/L2 RPCs if you use them
# ARBITRUM_RPC_URL=
# OPTIMISM_RPC_URL=
# POLYGON_RPC_URL=
# BASE_RPC_URL=

# --- API Keys for Services ---
# REQUIRED for gasless transactions via Account Abstraction (ERC-4337)
PIMLICO_API_KEY=
# Your Alchemy API key (can be the same as used in RPC URLs)
ALCHEMY_API_KEY=

# --- Security ---
# A long, random string used for signing JWTs.
JWT_SECRET=your_super_secret_random_string_for_jwt