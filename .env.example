# AlphaPro Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to version control!

# ===================
# Application Config
# ===================
NODE_ENV=production
PORT=3000
# IMPORTANT: Set to LIVE for real trading, PAPER for simulation
TRADING_MODE=LIVE

# ===================
# Database (Render provides)
# ===================
DATABASE_URL=postgresql://user:password@host:5432/alphapro

# ===================
# Redis (Render provides)
# ===================
REDIS_URL=redis://host:6379

# ===================
# Brain Service
# ===================
BRAIN_URL=http://alphapro-brain:5000
PYTHON_VERSION=3.11
FLASK_ENV=production

# ===================
# Blockchain RPCs
# ===================
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# ===================
# API Keys
# ===================
ALCHEMY_API_KEY=your_alchemy_key
INFURA_API_KEY=your_infura_key
BIRDEYE_API_KEY=your_birdeye_key
OPENAI_API_KEY=your_openai_key

# ===================
# Wallet (Required for LIVE trading)
# ===================
PRIVATE_KEY=your_ethereum_private_key
WALLET_ADDRESS=your_wallet_address

# ===================
# Account Security
# ===================
ADMIN_API_KEY=your_admin_api_key
JWT_SECRET=your_jwt_secret_min_32_chars

# ===================
# Gas & Execution
# ===================
PIMLICO_API_KEY=your_pimlico_api_key
BUNDLER_URL=https://api.pimlico.io/v2/1/rpc
PAYMASTER_URL=https://api.pimlico.io/v2/1/rpc
ENTRYPOINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# ===================
# Dashboard (React)
# ===================
VITE_API_URL=https://alphapro-api.onrender.com

