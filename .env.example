# AlphaPro Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control

# =============================================================================
# REQUIRED VARIABLES - Must be configured before deployment
# =============================================================================

# JWT Authentication Secret (generate a strong random string)
# Use: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here-change-this-in-production

# Ethereum RPC URL (Infura, Alchemy, or your own node)
# Mainnet: https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# Sepolia: https://sepolia.infura.io/v3/YOUR_PROJECT_ID
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Trading Wallet Private Key (DO NOT prefix with 0x)
# WARNING: This wallet will hold funds for trading
# Use a dedicated wallet with limited funds for testing
PRIVATE_KEY=your-private-key-without-0x-prefix

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://alphapro:changeme@localhost:5432/alphapro

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis Connection String
# Format: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# OpenAI API Key (required for AI features like AlphaCopilot)
OPENAI_API_KEY=sk-your-openai-api-key

# Server Configuration
PORT=3000
NODE_ENV=production

# Brain Service URL (for multi-container deployments)
BRAIN_URL=http://brain:5000

# Trading Configuration
TRADING_MODE=LIVE  # Options: LIVE, PAPER, TEST

# API Keys for External Services
# Chainlink Price Feeds (if using custom oracles)
CHAINLINK_API_KEY=your-chainlink-key

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-here
SESSION_TIMEOUT_MS=86400000  # 24 hours

# =============================================================================
# MONITORING & ALERTING
# =============================================================================

# Prometheus Metrics (enabled by default at /metrics)
PROMETHEUS_ENABLED=true

# Alert Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PAGERDUTY_KEY=your-pagerduty-integration-key
ALERT_EMAIL=alerts@yourcompany.com

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Gas Price Oracle (options: ethgasstation, gasnow, chainlink, manual)
GAS_ORACLE=chainlink

# Manual Gas Price (wei) - used if GAS_ORACLE=manual
MANUAL_GAS_PRICE=20000000000  # 20 gwei

# Maximum Slippage Tolerance (basis points, 100 = 1%)
MAX_SLIPPAGE_BPS=300

# Flash Loan Router (Uniswap V3)
UNISWAP_V3_FACTORY=0x1F98431c8aD98523631AE4a59f267346ea31F984
UNISWAP_V3_QUOTER=0xb27308f9F90D607463bb33eA1BeBb41C27CE5AB6

# Multi-path DEXes
ENABLED_DEXES=uniswap-v3,sushiswap,curve

# Circuit Breaker Thresholds
CIRCUIT_BREAKER_LOSS_THRESHOLD=0.05  # 5% loss triggers pause
CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=3

# =============================================================================
# DEVELOPMENT ONLY (DO NOT USE IN PRODUCTION)
# =============================================================================

# Skip authentication for development
# WARNING: NEVER enable this in production
DEV_SKIP_AUTH=false

# Enable debug logging
DEBUG=false

