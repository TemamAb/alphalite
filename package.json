{
  "name": "alphapro",
  "version": "2.0.0",
  "description": "AlphaPro Enterprise Flash Loan & MEV Arbitrage System",
  "main": "modules/api/app.js",
  "scripts": {
    "start": "node modules/api/app.js",
    "dev": "nodemon modules/api/app.js",
    "prove": "node prove-profit.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f engine",
    "preflight": "node PreFlightCheck.js",
    "build": "npm run build --workspace=modules/dashboard",
    "postinstall": "cd modules/api && npx prisma generate"
  },
  "keywords": [
    "flash-loan",
    "arbitrage",
    "mev",
    "defi",
    "blockchain"
  ],
  "author": "AlphaPro Team",
  "license": "ISC",
  "type": "commonjs",
  "private": true,
  "workspaces": [
    "modules/api",
    "modules/dashboard",
    "modules/brain"
  ],
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "5.7.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "qrcode": "^1.5.3",
    "reconnecting-websocket": "^4.4.0",
    "redis": "^4.6.10",
    "undici": "5.28.3",
    "userop": "^0.3.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
